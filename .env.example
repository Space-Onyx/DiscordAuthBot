# Discord bot token (обязателен)
DISCORD_KEY=PUT_DISCORD_BOT_TOKEN_HERE

# GitHub token для git-команд бота (опционально)
USER_KEY_GITHUB=PUT_GITHUB_TOKEN_HERE

# Сервисный админ для Actor в admin API
ADMIN_GUID=PUT_SS14_ADMIN_GUID_HERE
ADMIN_NAME=DiscordBot

# Глобальный fallback admin API токен
ADMIN_API=PUT_GLOBAL_ADMIN_API_TOKEN_HERE

# User-Agent для Watchdog запросов
POST_USER_AGENT=DiscordAuthBot/1.0

# API бота для глобальной отвязки (SS14 -> Bot)
BOT_API_TOKEN=PUT_BOT_API_TOKEN_HERE
# Тот же токен используется игровыми серверами для Round/AHelp/Ban push-уведомлений:
# discord.round_bot_api_token, ahelp.api_token и discord.ban_bot_api_token
# на сервере должны совпадать с BOT_API_TOKEN.
# Round API endpoint: POST /api/v1/round/event
# AHelp API endpoint: POST /api/v1/ahelp/event
# Ban API endpoint: POST /api/v1/ban/event
BOT_API_HOST=127.0.0.1
BOT_API_PORT=8088

# Глобальный канал для привязки аккаунтов (опционально, fallback)
CHANNEL_AUTH_DISCORD=
CHANNEL_LOG_AUTH_DISCORD=PUT_CHANNEL_LOG_AUTH_DISCORD_HERE
LOG_CHANNEL_ID=PUT_LOG_CHANNEL_ID_HERE
MY_DS_ID=PUT_MY_DISCORD_ID_HERE

# =============================
# СЛОТЫ СЕРВЕРОВ (до 5)
# =============================

# ----- SERVER 1 -----
SERVER_1_ENABLED=true
SERVER_1_NAME=astra
SERVER_1_ADDRESS=127.0.0.1
SERVER_1_STATUS_PORT=1616
SERVER_1_ADMIN_API_PORT=1212
SERVER_1_ADMIN_API_TOKEN=PUT_ASTRA_ADMIN_API_TOKEN_HERE
SERVER_1_POST_PORT=5000
SERVER_1_POST_INSTANCE=ASTRA
SERVER_1_POST_USERNAME=ASTRA
SERVER_1_POST_PASSWORD=PUT_ASTRA_POST_PASSWORD_HERE
SERVER_1_POST_AUTHORIZATION=
SERVER_1_DB_NAME=ss14_astra
SERVER_1_DB_HOST=127.0.0.1
SERVER_1_DB_PORT=5432
SERVER_1_DB_USER=postgres
SERVER_1_DB_PASS=PUT_ASTRA_DB_PASSWORD_HERE
# Канал для привязки аккаунтов (опционально, используется CHANNEL_AUTH_DISCORD по умолчанию)
# SERVER_1_CHANNEL_AUTH_DISCORD=
# Уведомления о раундах и ахелпах из игровых серверов (Round/AHelp API).
# GameHostName сервера (cvar game.hostname) для сопоставления push-событий; по умолчанию матчится по имени.
# SERVER_1_GAME_HOST_NAME=
# Каналы уведомлений (ID Discord-каналов).
# SERVER_1_ROUND_CHANNEL=
# SERVER_1_AHELP_CHANNEL=
# SERVER_1_BAN_CHANNEL=
# Пинг-роли (ID ролей). Отправляются отдельным content ВНЕ embed.
# Роль раундов пингуется только о конце раунда, роль ахелпов — только о новых обращениях.
# SERVER_1_ROUND_PING_ROLE=
# SERVER_1_AHELP_PING_ROLE=

# ----- SERVER 2 -----
SERVER_2_ENABLED=true
SERVER_2_NAME=dev
SERVER_2_ADDRESS=127.0.0.1
SERVER_2_STATUS_PORT=1717
SERVER_2_ADMIN_API_PORT=1313
SERVER_2_ADMIN_API_TOKEN=PUT_DEV_ADMIN_API_TOKEN_HERE
SERVER_2_POST_PORT=5001
SERVER_2_POST_INSTANCE=DEV
SERVER_2_POST_USERNAME=DEV
SERVER_2_POST_PASSWORD=PUT_DEV_POST_PASSWORD_HERE
SERVER_2_POST_AUTHORIZATION=
SERVER_2_DB_NAME=ss14_dev
SERVER_2_DB_HOST=127.0.0.1
SERVER_2_DB_PORT=5432
SERVER_2_DB_USER=postgres
SERVER_2_DB_PASS=PUT_DEV_DB_PASSWORD_HERE
# Канал для привязки аккаунтов (опционально)
# SERVER_2_CHANNEL_AUTH_DISCORD=
# Уведомления о раундах и ахелпах (см. комментарий SERVER_1 выше).
# SERVER_2_GAME_HOST_NAME=
# SERVER_2_ROUND_CHANNEL=
# SERVER_2_AHELP_CHANNEL=
# SERVER_2_BAN_CHANNEL=
# SERVER_2_ROUND_PING_ROLE=
# SERVER_2_AHELP_PING_ROLE=

# ----- SERVER 3..5 -----
# SERVER_3_ENABLED=false
# SERVER_4_ENABLED=false
# SERVER_5_ENABLED=false

# Серверы по умолчанию
DEFAULT_SERVER=astra
DEFAULT_DB_SERVER=astra
STATUS_MESSAGE_SERVER=astra

CHECK_NICK_ACCOUNT_WHITELIST=MainCkey,OtherMainCkey

